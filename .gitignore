# Secrets — never commit. Covers .env, .env.local, .env.disabled-backup, etc.
.env*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/

# ADK local session state
.adk/

# Local demo photos (add manually per SETUP)
demo_assets/

# macOS
.DS_Store

# Local scratch, not part of the project
_to_delete/

# Batch agent worktrees — branches live on the remote, these are scratch
.claude/worktrees/

# Raw captured pipeline runs. Saved before parsing so a billed run survives a
# validation failure (scripts/record_golden_run.py --from-raw). May hold model
# output verbatim, so it stays local.
.golden_runs/

# Editor swap files.
*.sw[a-p]
