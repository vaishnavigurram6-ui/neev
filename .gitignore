# Secrets — never commit. Covers .env, .env.local, .env.disabled-backup, etc.
.env*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/

# ADK local session state
.adk/

# Local demo photos (add manually per SETUP)
demo_assets/

# macOS
.DS_Store

# Local scratch, not part of the project
_to_delete/

# Batch agent worktrees — branches live on the remote, these are scratch
.claude/worktrees/

# .golden_runs/ IS committed (owner's call, 2026-09-07). They are the raw
# evidence behind every figure the app serves and every claim the demo runbook
# makes, they are records rather than regenerated artefacts so they never churn,
# and they carry no credentials. See .golden_runs/README.md.

# Editor swap files.
*.sw[a-p]

# Private uploads (local only; never commit borrower documents).
artifacts/

# Synthetic BoQ PDFs ARE committed (owner's call, 2026-09-07), so Cloud Shell
# and a judge get the documents without installing reportlab. Safe to track
# because scripts/synthetic_boqs.py sets rl_config.invariant, which fixes the
# CreationDate and document id -- regenerating produces identical bytes.

# Working notes kept out of the submitted repository. All still on disk; none of
# them describe the product, and two of them (the form answers and the blog
# draft) are drafts of things that are not ours to publish from here.
docs/Neev_Submission_Form_Answers.md
docs/Neev_Blog_Draft.md
docs/Neev_Demo_Video_Plan.md
docs/Neev_Prod_Deploy_Plan.md
docs/Neev_Two_Week_Plan.md
docs/Review_Remediation.md

# A shelved alternative deployment (one Cloud Run service, two containers),
# explored in a parallel session and not adopted: the two-service path is the
# exercised one. Kept on disk because the analysis is worth more than the code.
deploy/

# Demo audio and video rendered in another session. 23MB of mp3/mp4, and the
# form wants a YouTube or Drive link for the video rather than a file in the
# repo. Ignored so a `git add -A` cannot sweep it in -- which is exactly how
# deploy/ got committed by mistake.
Claude outputs/
